{
  "name": "@needle/logo",
  "version": "0.2.3",
  "description": "内置调试控制台的 TypeScript 日志库：浏览器里看日志、敲命令、订指标",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./console": {
      "types": "./dist/console/index.d.ts",
      "default": "./dist/console/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./lark": {
      "types": "./dist/core/logo/sinks/lark.d.ts",
      "default": "./dist/core/logo/sinks/lark.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:ui": "bun scripts/build-ui.mjs",
    "build": "bun run build:ui && rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "size": "bun build src/core/index.ts --minify --target=browser | gzip -c | wc -c && bun build src/console/index.ts --minify --target=browser | gzip -c | wc -c"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "happy-dom": "^21.0.4",
    "miniflare": "^4.20260730.0",
    "typescript": "7.0.2"
  }
}
