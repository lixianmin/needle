{
  "name": "@noodle/logo",
  "version": "0.1.0",
  "description": "内置调试控制台的 TypeScript 日志库：浏览器里看日志、敲命令、订指标",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./console": {
      "types": "./dist/console/index.d.ts",
      "default": "./dist/console/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./lark": {
      "types": "./dist/lark/index.d.ts",
      "default": "./dist/lark/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "7.0.2"
  }
}
