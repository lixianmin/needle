{
  "name": "needle",
  "version": "0.3.68",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:got": "tsc -p packages/got/tsconfig.build.json",
    "build:logo": "tsc -p packages/logo/tsconfig.build.json",
    "build:ui": "bun scripts/build-ui.mjs",
    "build:shell": "tsc -p packages/shell/tsconfig.build.json",
    "build:honox": "tsc -p packages/honox/tsconfig.build.json",
    "build": "rm -rf packages/*/dist && bun run build:got && bun run build:logo && bun run build:ui && bun run build:shell && bun run build:honox",
    "demo": "bun run build:logo && bun examples/demo.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "size": "bun build scripts/size-log-only.ts --minify --target=browser | gzip -c | wc -c && bun build packages/shell/dist/index.js --minify --target=browser | gzip -c | wc -c",
    "version:sync": "bun scripts/sync-version.mjs",
    "example:install": "cd examples/honox-app && bun install --frozen-lockfile",
    "example:build": "cd examples/honox-app && bun run build",
    "example": "cd examples/honox-app && bun dist/index.js",
    "example:typecheck": "cd examples/honox-app && bunx tsc --noEmit",
    "mutate": "bunx stryker run --inPlace",
    "mutate:full": "bunx stryker run --inPlace --force",
    "coverage": "bun test --coverage-reporter=lcov --coverage-dir=coverage && bun scripts/check-coverage.ts"
  },
  "devDependencies": {
    "@needle/got": "workspace:*",
    "@needle/honox": "workspace:*",
    "@needle/logo": "workspace:*",
    "@needle/shell": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@stryker-mutator/core": "^10.1.1",
    "@types/bun": "^1.4.3",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "miniflare": "^4.20260730.0",
    "typescript": "7.0.2",
    "typescript-6": "npm:typescript@6.0.3"
  }
}
