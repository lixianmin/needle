#!/bin/sh
# 提交前重建三份 dist 与内联页面脚本，产物随源码进入同一个 commit
# （docs/superpowers/specs/2026-10-24-three-packages-design.md §9）。
# clone 下来不先构建也能跑测试与 smoke，所以 dist 必须留在仓库里。
set -e

bun run version:sync
# bun.lock 也记录 workspace 包的版本：同步后刷新它，否则锁文件与 package.json 漂移。
bun install --silent
bun run build
# model class → TypeBox schema：生成物跟 dist 一样随源码提交（spec §5.5）。
if [ -d examples/honox-app/app/beans ]; then
  # find 而不是 shell glob：glob 不递归，beans 下建子目录时生成物会永远不重建。
  MODEL_FILES=$(find examples/honox-app/app/beans -name '*.ts' ! -name '*.generated.ts' | sort)
  if [ -n "$MODEL_FILES" ]; then
    # 关掉 glob、只按换行切分：bean 文件名里有空格也不会被拆成两个参数。
    set -f
    OLDIFS=$IFS
    IFS='
'
    bun scripts/gen-models.ts $MODEL_FILES
    IFS=$OLDIFS
    set +f
  fi
  # 无论是否还有 bean 都要 stage：删掉最后一个 bean 时也要把删除带走。
  git add examples/honox-app/app/beans
fi
git add bun.lock packages/*/package.json packages/*/dist packages/shell/src/ui/script.generated.ts
