{
  "name": "@needle/honox",
  "version": "0.3.54",
  "description": "业务无关的 Hono 底座：配置 / JWT 鉴权 / 请求日志 / Mongo / Excel / Shell",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./mongo": {
      "types": "./dist/mongo.d.ts",
      "default": "./dist/mongo.js"
    },
    "./excel": {
      "types": "./dist/excel.d.ts",
      "default": "./dist/excel.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@needle/got": "workspace:*",
    "@needle/logo": "workspace:*",
    "@needle/shell": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "hucre": "^1.2.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "hono": "^4",
    "mongodb": "^7"
  },
  "devDependencies": {
    "hono": "^4.13.13",
    "mongodb": "^7.7.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  }
}
