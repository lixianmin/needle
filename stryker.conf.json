{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test packages/honox/test"
  },
  "mutate": [
    "packages/honox/src/auth.ts",
    "packages/honox/src/config.ts",
    "packages/honox/src/excel.ts",
    "packages/honox/src/id.ts",
    "packages/honox/src/middleware.ts",
    "packages/honox/src/mongo.ts",
    "packages/honox/src/node.ts",
    "packages/honox/src/route.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 30000,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "tempDirName": ".stryker-tmp",
  "disableTypeChecks": false
}
