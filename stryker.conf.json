{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test packages/honox/test"
  },
  "mutate": [
    "packages/honox/src/**/*.ts",
    "!packages/honox/src/types.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 30000,
  "thresholds": {
    "high": 90,
    "low": 89.7,
    "break": 89.7
  },
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "incremental": false,
  "tempDirName": ".stryker-tmp",
  "disableTypeChecks": false
}
